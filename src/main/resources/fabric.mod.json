{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "https://github.com/yigit-guven/Petting",
    "sources": "https://github.com/yigit-guven/Petting",
    "issues": "https://github.com/yigit-guven/Petting/issues"
  },
  "license": "${mod_license}",
  "icon": "logo.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.yigitguven.petting.Petting"
    ],
    "client": [
      "net.yigitguven.petting.client.PettingClient"
    ],
    "modmenu": [
      "net.yigitguven.petting.client.gui.PettingModMenuIntegration"
    ]
  },
  "mixins": [
    "petting.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version_range}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
